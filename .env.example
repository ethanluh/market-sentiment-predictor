# Copy to .env and fill in values. Never commit .env.

# News
NEWS_API_KEY=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=market-sentiment-predictor/0.1

# SEC EDGAR (descriptive User-Agent email required by the SEC)
SEC_EDGAR_EMAIL=

# Serving: path to a trained model artifact (scripts/train_model.py).
# If unset, /predict falls back to the unfitted default (no predictions).
MODEL_PATH=

# Polygon.io (optional, yfinance used by default)
POLYGON_API_KEY=

# Finnhub (optional, for earnings transcripts)
FINNHUB_API_KEY=

# Database (TimescaleDB / Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/market_sentiment

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Environment
LOG_LEVEL=INFO
