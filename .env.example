# Copy to .env and fill in values. Never commit .env.

# News
# NewsAPI: free tier serves only ~30 days of history.
NEWS_API_KEY=
# Alpha Vantage NEWS_SENTIMENT: alternative news source with deeper free history
# (back to ~2022) and native ticker tagging. Used by
# scripts/build_news_archive.py --source alphavantage.
ALPHAVANTAGE_API_KEY=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=market-sentiment-predictor/0.1

# SEC EDGAR (descriptive User-Agent email required by the SEC)
SEC_EDGAR_EMAIL=

# Google Trends (pytrends): no API key required. Locale / window are passed as
# fetch_trends() arguments (geo, timeframe), not via environment variables.

# Serving: path to a trained model artifact (scripts/train_model.py).
# REQUIRED by the API — the app fails fast at startup if it is unset/unloadable.
# (The src.pipeline.run CLI and backtest still run without it.)
MODEL_PATH=

# Logging
LOG_LEVEL=INFO

# --- Planned / not yet wired (see docs/data_sources.md, docs/architecture.md) ---
# POLYGON_API_KEY=
# FINNHUB_API_KEY=
# DATABASE_URL=
# MLFLOW_TRACKING_URI=
